{
    "name": "justinholtweb/craft-bed",
    "description": "Every embed gets a bed — reserved space measured from real page views, loading deferred until it is wanted, and warmed connections for the ones that are wanted immediately.",
    "version": "5.0.1",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "embed",
        "performance",
        "lazy-loading",
        "core-web-vitals",
        "cls",
        "iframe"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-bed",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\bed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\bed\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Bed",
        "handle": "bed",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-bed/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-bed/main/CHANGELOG.md",
        "class": "justinholtweb\\bed\\Plugin"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^1.12 || ^2.2"
    }
}
