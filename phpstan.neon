includes:
    - vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 4
    paths:
        - src
    excludePaths:
        - src/templates
    # Settings and rules arrive from project config, which can be hand-edited: the type checks
    # against PHPDoc shapes are deliberate, not redundant.
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Toss is the family's consent manager and an optional companion, never a dependency. Every
        # reference sits in services/Consent::tossIsActive(), which asks the plugins service before
        # naming a Toss class.
        -
            message: '#justinholtweb\\toss#'
            reportUnmatched: false
